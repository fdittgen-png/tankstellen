  #3740 — Android 12+ data-extraction rules. Mirrors backup_rules.xml
  (the ≤ Android 11 file) for BOTH extraction paths: cloud-backup
  (Google One Auto-Backup) and device-transfer (D2D migration). See
  backup_rules.xml for the per-exclusion rationale — in short: no auth
  session, no widget prefs, no crash journal leaves the device, and
  (#4118) neither does the encrypted database nor its key store, since
  the KeyStore master key behind it cannot follow either of them.

  Device-transfer carries the SAME hole as cloud-backup: KeyStore
  material is hardware-bound and is not migrated, so both blocks need
  every exclusion. A rule present in one block and missing from the
  other is the bug, not a shortcut.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
        <exclude domain="sharedpref" path="HomeWidgetPreferences.xml"/>
        <exclude domain="file" path="crash_journal/"/>
        <exclude domain="root" path="app_flutter/"/>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
        <exclude domain="sharedpref" path="HomeWidgetPreferences.xml"/>
        <exclude domain="file" path="crash_journal/"/>
        <exclude domain="root" path="app_flutter/"/>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration.xml"/>
    </device-transfer>
</data-extraction-rules>
