  #3740 — Android 12+ data-extraction rules. Mirrors backup_rules.xml
  (the ≤ Android 11 file) for BOTH extraction paths: cloud-backup
  (Google One Auto-Backup) and device-transfer (D2D migration). See
  backup_rules.xml for the per-exclusion rationale — in short: no auth
  session, no widget prefs, no crash journal leaves the device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
        <exclude domain="sharedpref" path="HomeWidgetPreferences.xml"/>
        <exclude domain="file" path="crash_journal/"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
        <exclude domain="sharedpref" path="HomeWidgetPreferences.xml"/>
        <exclude domain="file" path="crash_journal/"/>
    </device-transfer>
</data-extraction-rules>
