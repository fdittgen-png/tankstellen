{
  "stationStatusWithFreshness": "{status} · updated {ago} ago",
  "@stationStatusWithFreshness": {
    "description": "Station-detail header line: the open / closed / unknown state followed by how long ago the data was fetched. Owns the whole word order per locale — never composed from fragments (#3902).",
    "placeholders": {
      "status": {
        "type": "String",
        "example": "Open"
      },
      "ago": {
        "type": "String",
        "example": "< 1 min"
      }
    }
  },
  "pricesNotSoldHere": "Not sold here: {fuels}",
  "@pricesNotSoldHere": {
    "description": "Muted footnote under the station-detail price list naming the base fuels this station has no price for (they are hidden from the list). {fuels} is a comma-joined list of fuel codes (#3902).",
    "placeholders": {
      "fuels": {
        "type": "String",
        "example": "Super E5, Super E10"
      }
    }
  }
}
